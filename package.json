{
  "name": "event-storming-mcp",
  "version": "0.1.0",
  "description": "Live EventStorming board for scrum-domain-modeling models: a local server everyone watches, an MCP server agents edit through, inline editing and history.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "event-storming-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "model",
    "docs/data-format.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowly-lab/event-storming-mcp.git"
  },
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "prepare": "tsc && node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test --test-timeout=30000 'test/**/*.test.ts' 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
